# Base URL of the ElysiaJS REST API (versioned)
VITE_API_BASE_URL=/api/v1
# Dev-server proxy target for /api (optional, e.g. http://localhost:3000)
VITE_API_PROXY_TARGET=
# Use the in-browser mock API (no backend required). Never enable in production.
VITE_API_MOCK=false
# Public site origin, used for canonical/OG URLs
VITE_SITE_URL=http://localhost:5173
# Max upload size (MB), validated client-side before upload (server validates again)
VITE_UPLOAD_MAX_MB=10
